# Supabase Database & Auth
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
# Server-only secret. Never expose this value to frontend/client code.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Telegram Bot Notifications
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_BROADCAST_GROUP_ID=your_broadcast_group_id_here
MINI_APP_URL=https://your-domain.example

# Admin Auth & Passcode
ADMIN_PASSCODE=your_admin_passcode_here
ADMIN_SECRET_TOKEN=your_admin_secret_token_here
JWT_SECRET=your_jwt_secret_here

# Payment & Cloud Integrations
SMARTPAY_API_KEY=your_smartpay_api_key_here
SMARTPAY_SECRET=your_smartpay_secret_here
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name_here
CLOUDINARY_API_KEY=your_cloudinary_api_key_here
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here
OCR_API_KEY=your_ocr_api_key_here
CRM_CUSTOMER_KEY_SECRET=your_crm_customer_key_secret_here
