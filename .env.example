# Supabase Database & Auth
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
# Server-only secret. Never expose this value to frontend/client code.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Telegram Bot Notifications
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_BROADCAST_GROUP_ID=your_broadcast_group_id_here
MINI_APP_URL=https://your-domain.example
# Dedicated shared secret used only between the Telegram bot and backend claim endpoints.
CLAIM_BOT_SHARED_SECRET=replace_with_a_long_random_secret

# Admin Auth & Passcode
ADMIN_PASSCODE=your_admin_passcode_here
ADMIN_SECRET_TOKEN=your_admin_secret_token_here
JWT_SECRET=your_jwt_secret_here

# OSON SMS — Manual Booking Automatic Ticket Delivery (Stage 5 contract)
# All default to safe/off. Never flip OSON_SMS_ENABLED/OSON_SMS_DELIVERY_ENABLED
# in production before the OSON contract is independently reverified (see
# docs/oson-sms-audit-report.md) and OSON_SMS_HASH has been rotated.
OSON_SMS_ENABLED=false
OSON_SMS_DELIVERY_ENABLED=false
OSON_SMS_DRY_RUN=true
OSON_SMS_BASE_URL=https://api.osonsms.com/sendsms_v1.php
OSON_SMS_LOGIN=your_oson_sms_login_here
OSON_SMS_HASH=your_oson_sms_secret_hash_here
OSON_SMS_SENDER=your_oson_confirmed_sender_id_here
OSON_SMS_TIMEOUT_MS=10000
OSON_SMS_ALLOWED_COUNTRIES=TJ
OSON_SMS_DAILY_CAP=0
OSON_SMS_PER_PHONE_DAILY_CAP=1
OSON_SMS_PER_CARRIER_DAILY_CAP=0
OSON_SMS_CARRIER_ALLOWLIST=
OSON_SMS_ROLLOUT_STARTED_AT=
# HMAC key for phone-number cap-tracking hashes; separate from JWT_SECRET on purpose.
OSON_SMS_PHONE_HASH_SECRET=your_oson_sms_phone_hash_secret_here

# Payment & Cloud Integrations
SMARTPAY_API_KEY=your_smartpay_api_key_here
SMARTPAY_SECRET=your_smartpay_secret_here
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name_here
CLOUDINARY_API_KEY=your_cloudinary_api_key_here
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here
OCR_API_KEY=your_ocr_api_key_here
CRM_CUSTOMER_KEY_SECRET=your_crm_customer_key_secret_here
