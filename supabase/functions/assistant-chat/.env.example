# ============================================================================
# Environment Configuration Template for assistant-chat Edge Function
# DO NOT COMMIT REAL CREDENTIALS OR SECRETS.
# ============================================================================

# Master Kill Switch: 'true' enables the AI endpoint, 'false' keeps it disabled
AI_ASSISTANT_ENABLED=false

# Pre-shared secret between Vercel Telegram Bot and assistant-chat Edge Function
# Must be at least 32 cryptographically random alphanumeric characters.
INTERNAL_BOT_ASSISTANT_SECRET=your_internal_bot_assistant_secret_here

# Anthropic API Key (must have Claude 3.5 Sonnet access)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Model identifier (standard alias)
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# Supabase Project Credentials (injected automatically in Supabase Cloud)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Rate Limiting & Safety Limits
AI_BURST_LIMIT=2
AI_DAILY_USER_LIMIT=5
AI_GLOBAL_DAILY_LIMIT=500
